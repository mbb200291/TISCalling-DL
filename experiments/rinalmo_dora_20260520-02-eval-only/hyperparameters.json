{
  "seed": 42,
  "threshold": 0.5,
  "label_column": "label",
  "group_column": "gene_id",
  "rinalmo_model_id": "multimolecule/rinalmo-micro",
  "device": "cuda:0",
  "pad_token": "<pad>",
  "lora_r": 4,
  "lora_alpha": 32,
