  "pooling_mode": "attention",
  "batch_size": 16,
  "log_every_n_batches": 10,
  "max_epoch": 50,
  "early_stopping_patience": 5,
  "scheduler_factor": 0.5,
  "scheduler_patience": 3,
  "scheduler_min_lr": 0.000001,
  "pos_weight_fold": 0.5,
  "noncanonical_weight_fold": 10,
  "annotated_section_id": 0,
  "max_weight": 200,
  "lr": 0.0001,
  "left_window": 411,
  "right_window": 101,
  "test_frac": 0.2,
  "dev_frac": 0.1,
  "ignore_sec": 0,
  "gradient_checkpointing_enable": false,
  "use_peft": true
