{
  "seed": 42,
  "threshold": 0.5,
  "label_column": "label",
  "group_column": "gene_id",
  "rinalmo_model_id": "multimolecule/rinalmo-micro",
  "device": "cuda:0",
  "pad_token": "<pad>",
  "lora_r": 4,
  "lora_alpha": 32,
  "lora_dropout": 0.1,
  "target_modules": ["query", "key", "value", "dense"],
  "num_heads": 8,
  "dropout": 0.1,
  "pooling_mode": "attention",
  "batch_size": 16,
  "log_every_n_batches": 10,
  "max_epoch": 50,
  "early_stopping_patience": 5,
  "scheduler_factor": 0.5,
  "scheduler_patience": 3,
  "scheduler_min_lr": 0.000001,
  "section_scaling": 0,
  "section_weight_fold": {
    "0": 1,
    "1": 10,
    "2": 10,
    "3": 10,
    "4": 10
  },
  "section_label_scaling": 1,
  "section_pos_weight_fold": {
    "0": 1,
    "1": 2,
    "2": 5,
    "3": 2,
    "4": 5
  },
  "max_weight": 200,
  "lr": 0.0001,
  "left_window": 411,
  "right_window": 101,
  "test_frac": 0.2,
  "dev_frac": 0.1,
  "ignore_sec": 0,
  "gradient_checkpointing_enable": false,
  "use_peft": true
}
